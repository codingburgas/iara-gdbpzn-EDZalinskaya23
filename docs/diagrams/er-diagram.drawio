<mxfile host="app.diagrams.net">
  <diagram name="ER diagram (database)" id="er1">
    <mxGraphModel dx="1407" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="vehicles" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="vehicles&#xa;&#xa;PK id&#xa;name&#xa;plate&#xa;type" vertex="1">
